# 真实运行所需的 API key（复制本文件为 .env 后填入）

# Moonshot 通用 API key（kimi / kimi-k2.7-code / kimi-k2.6 等）
# 获取地址：https://platform.moonshot.cn/
MOONSHOT_API_KEY=sk-your-key-here

# Kimi Code 专用 API key（kimi-code / kimi-code-256k / kimi-code-k2.7 等）
# 获取地址：https://www.kimi.com/code/console
#KIMI_CODE_API_KEY=sk-your-key-here

# 默认启动的模型档案（可选，默认 kimi；可选值见 models.default.json）
# 切到 kimi-code-* 档案时，需要配置 KIMI_CODE_API_KEY
#MINI_AGENT_MODEL=kimi
